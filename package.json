{
  "name": "@juicesharp/rpiv-todo",
  "version": "2.12.0-rodrigo.1",
  "private": true,
  "description": "Pi extension. A todo list for the model, rendered as a live overlay that survives /reload and conversation compaction.",
  "keywords": [
    "pi-package",
    "pi-extension",
    "rpiv",
    "todo"
  ],
  "type": "module",
  "license": "MIT",
  "author": "juicesharp",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rodrigojager/rpiv-todo.git"
  },
  "homepage": "https://github.com/rodrigojager/rpiv-todo#readme",
  "bugs": {
    "url": "https://github.com/rodrigojager/rpiv-todo/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "pack:dry-run": "npm pack --dry-run"
  },
  "files": [
    "config.ts",
    "index.ts",
    "locales/",
    "todo.ts",
    "todo-overlay.ts",
    "LICENSE",
    "docs/",
    "!docs/*.png",
    "!docs/*.jpg",
    "!docs/*.svg",
    "README.md",
    "state/invariants.ts",
    "state/i18n-bridge.ts",
    "state/replay.ts",
    "state/selectors.ts",
    "state/state-reducer.ts",
    "state/state.ts",
    "state/store.ts",
    "state/task-graph.ts",
    "tool/response-envelope.ts",
    "tool/sanitize.ts",
    "tool/types.ts",
    "view/format.ts",
    "LOCAL-CHANGES.md",
    "CHANGELOG.md"
  ],
  "pi": {
    "image": "https://raw.githubusercontent.com/juicesharp/rpiv-mono/main/packages/rpiv-todo/docs/cover.png",
    "extensions": [
      "./index.ts"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "@juicesharp/rpiv-i18n": "2.12.0",
    "typebox": "*"
  },
  "peerDependenciesMeta": {
    "@juicesharp/rpiv-i18n": {
      "optional": true
    }
  },
  "dependencies": {
    "@juicesharp/rpiv-config": "^2.12.0"
  },
  "devDependencies": {
    "jiti": "2.7.0",
    "@earendil-works/pi-coding-agent": "1.0.0",
    "@earendil-works/pi-ai": "1.0.0",
    "@earendil-works/pi-tui": "1.0.0",
    "typebox": "1.3.34"
  }
}
